{
  "name": "pos-desktop",
  "version": "1.0.0",
  "description": "Aplicación POS Desktop para El Salvador",
  "main": "dist/main.js",
  "author": "Your Company",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "concurrently \"npm run react-dev\" \"npm run electron-dev\"",
    "react-dev": "vite --port 3001",
    "electron-dev": "wait-on http://localhost:3001 && electron .",
    "build": "npm run react-build && npm run electron-build",
    "react-build": "vite build",
    "electron-build": "tsc",
    "package": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.4.0",
    "axios": "^1.6.2",
    "lucide-react": "^latest",
    "better-sqlite3": "^9.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/better-sqlite3": "^7.6.4",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "typescript": "^5.3.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.possystem.app",
    "productName": "POS System",
    "files": ["dist/**/*", "node_modules/**/*"],
    "directories": {
      "buildResources": "assets"
    }
  }
}
